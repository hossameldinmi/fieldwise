{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fieldwise",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "fieldwise" }],
  "routes": [{ "pattern": "fieldwise.canarie.dev", "custom_domain": true }],
  // Production serves only the custom domain. Preview URLs (<alias>-fieldwise.<account>.workers.dev) carry
  // per-PR versions uploaded by .github/workflows/preview.yml; they never receive production traffic.
  "workers_dev": false,
  "preview_urls": true,
  "vars": { "NOMINATIM_USER_AGENT": "FieldWise/0.1 (+https://fieldwise.canarie.dev)" },
  "observability": { "enabled": true }
}
